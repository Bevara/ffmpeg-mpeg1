{
    "name": "ffmpeg-mpeg1",
    "version": "1.0.2",
    "description": "ffmpeg mpeg1 decoder",
    "filters":["ffdec","rfmpgvid","m2psdmx"],
    "help": "This is a reduced version of ffmpeg adapted to decode mpeg1 contents in a canvas.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/ffmpeg-mpeg1.accessor",
    "filter_source":{
        "ffdec" : "ff_dec-mpeg1.c",
        "rfmpgvid" : "reframe_mpegvid.c",
        "m2psdmx" : "dmx_mpegps.c"
    },
    "Format": ["MPEG Video", "MPEG-PS"],
    "extension":{
      "mpg" : "canvas"
    },
    "using": ["mm_solver_1.0.1", "mm_solver_1.0.2"],
    "runtime": {
        "ffdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_YUV",
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV444"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "expired",
        "note": "MPEG-1 and MPEG-2 video",
        "checked": "2026-10-16"
    }
}
